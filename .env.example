# --- MySQL ---
# Local dev: these match docker-compose.yml as-is.
# Production: Aiven for MySQL (free plan) -- host/port/user/password/db are
# on the service's Overview page; download its CA cert there too.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=taxi
MYSQL_PASSWORD=taxi
MYSQL_DATABASE=taxi
# Path to Aiven's ca.pem. Leave unset locally (docker MySQL has no TLS).
MYSQL_SSL_CA=

# --- Extract ---
# First TLC month to load into an empty database. 2024-01 keeps a full
# backfill (~3M hourly rows) well inside Aiven's 1 GB free tier.
BACKFILL_START=2024-01
